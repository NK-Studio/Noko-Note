# 웹 서버 주소
NOKO_ADDR=127.0.0.1:3000
# DB·업로드·요약 md 파일이 저장되는 폴더
NOKO_DATA_DIR=data
# Whisper 모델
NOKO_MODELS_DIR=models
# 특정 모델 파일을 직접 쓸 때만 지정
WHISPER_MODEL=
WHISPER_LANG=ko
# Claude 계정 연동에 쓰는 Claude Code CLI 경로
# 비우면 자동으로 찾음
CLAUDE_BIN=
# 화면 위쪽 "요약 모델"에서 고르는 것이 우선. 화면에서 고른 적이 없을 때만 쓰이며,
# 비우면 claude-opus-5-5. 예: claude-sonnet-5-5
CLAUDE_MODEL=
