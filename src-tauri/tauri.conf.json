{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noko-Note",
  "version": "0.1.2",
  "identifier": "com.noko.note",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "음성 녹음을 받아쓰고 채널별로 요약하는 노트",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 428 },
        "appPosition": { "x": 170, "y": 190 },
        "applicationFolderPosition": { "x": 490, "y": 190 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
